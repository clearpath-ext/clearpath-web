---
// Scroll-driven demo: a cluttered news page that ClearPath tidies as you scroll.
// Four phases, each a 0–1 CSS variable set by the script below:
//   --clutter  ads, pop-ups and the sidebar fade away
//   --reader   the article switches to Reading Mode (bigger type, warm page)
//   --ruler    the reading ruler slides in and dims the other lines
//   --symbols  AAC symbols appear above key words
// With motion paused (or reduced in the OS) it skips the scroll effect and
// shows the finished page.

const SYMBOL = (word: string, file: string) =>
  `<span class="dd-w">${word}<img class="dd-pic" src="/symbols/${file}.png" alt="" width="40" height="40" loading="lazy" /></span>`;

const article = [
  'Beginning next term, Lincoln',
  SYMBOL('School', 'school'),
  'will implement a supplementary literacy initiative whereby pupils requiring additional',
  SYMBOL('help', 'help'),
  'with',
  SYMBOL('reading', 'read'),
  'will receive individualised support from a designated',
  SYMBOL('teacher', 'teacher'),
  'each',
  SYMBOL('morning,', 'morning'),
  'prior to the commencement of scheduled instruction. Parents wishing to enrol their child should complete the relevant documentation at their earliest convenience.',
].join(' ');

const steps = ['Clutter cleared', 'Reading Mode', 'Reading ruler', 'AAC symbols'];
---

<section class="max-w-6xl mx-auto px-6 pt-16" aria-labelledby="declutter-heading">
  <div class="text-center mb-6">
    <h2 id="declutter-heading" class="font-display text-3xl md:text-4xl text-white mb-3 animate-fade-up">
      Watch a page clear up.
    </h2>
    <p class="text-white/75 animate-fade-up delay-100">
      Keep scrolling. This is what ClearPath does to a busy page, one step at a time.
    </p>
  </div>

  <div class="dd-track" data-declutter>
    <div class="dd-sticky">
      <ol class="dd-steps" aria-hidden="true">
        {steps.map((label, i) => (
          <li class="dd-step" data-step={i}><span class="dd-step-num">{i + 1}</span>{label}</li>
        ))}
      </ol>

      <div
        class="dd-browser"
        role="img"
        aria-label="A cluttered news page with a sale banner, cookie notice, pop-up and sidebar ads. ClearPath removes the clutter, switches the article to Reading Mode with larger text, adds a reading ruler, and shows AAC symbols above the words school, help, reading, teacher and morning."
      >
        <div class="dd-chrome" aria-hidden="true">
          <span class="dd-dots"><i></i><i></i><i></i></span>
          <span class="dd-url">localnews.example/schools/reading-help</span>
        </div>

        <div class="dd-page" aria-hidden="true">
          <div class="dd-banner dd-clutter">MEGA SALE · 70% OFF EVERYTHING · TODAY ONLY</div>

          <div class="dd-layout">
            <article class="dd-article">
              <div class="dd-reader-bg"></div>
              <div class="dd-ruler"></div>
              <p class="dd-kicker">Local schools</p>
              <h3 class="dd-title">New morning reading help at Lincoln School</h3>
              <p class="dd-text" set:html={article} />
            </article>

            <aside class="dd-side dd-clutter">
              <div class="dd-ad">AD · You won't believe these 12 gadgets</div>
              <div class="dd-ad dd-ad--tall">AD · Autoplay video</div>
              <p class="dd-trending">Trending now</p>
              <ul><li></li><li></li><li></li></ul>
            </aside>
          </div>

          <div class="dd-popup dd-clutter">
            <p class="dd-popup-title">Don't miss out!</p>
            <p>Subscribe for 47 daily newsletters.</p>
            <span class="dd-popup-btn">Sign me up</span>
          </div>

          <div class="dd-cookie dd-clutter">
            <span>We value your privacy (and 812 partners do too).</span>
            <span class="dd-cookie-btn">Accept all</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <p class="text-center text-xs text-white/60 mt-4">
    Pictograms: <a href="https://arasaac.org" class="underline hover:text-white" target="_blank" rel="noopener noreferrer">ARASAAC</a> (Sergio Palao, Government of Aragón), CC BY-NC-SA
  </p>
</section>

<script>
  const track = document.querySelector<HTMLElement>('[data-declutter]');
  const steps = Array.from(document.querySelectorAll<HTMLElement>('.dd-step'));

  if (track) {
    const smooth = (a: number, b: number, x: number) => {
      const t = Math.min(1, Math.max(0, (x - a) / (b - a)));
      return t * t * (3 - 2 * t);
    };
    const reduced = () => (window as any).isMotionReduced?.() === true;

    const set = (p: number) => {
      const phases = [
        smooth(0.04, 0.26, p),  // clutter
        smooth(0.3, 0.52, p),   // reader
        smooth(0.56, 0.72, p),  // ruler
        smooth(0.76, 0.92, p),  // symbols
      ];
      ['--clutter', '--reader', '--ruler', '--symbols'].forEach((name, i) =>
        track.style.setProperty(name, phases[i].toFixed(3)),
      );
      steps.forEach((el, i) => {
        el.classList.toggle('is-done', phases[i] >= 0.5);
        el.classList.toggle('is-current', phases[i] >= 0.5 && (i === phases.length - 1 || phases[i + 1] < 0.5));
      });
    };

    let frame = 0;
    const update = () => {
      frame = 0;
      if (reduced()) {
        track.classList.add('is-static');
        set(1);
        return;
      }
      track.classList.remove('is-static');
      const rect = track.getBoundingClientRect();
      const travel = rect.height - window.innerHeight;
      set(travel > 0 ? Math.min(1, Math.max(0, -rect.top / travel)) : 1);
    };
    const queue = () => { if (!frame) frame = requestAnimationFrame(update); };

    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    document.addEventListener('motionchange', queue);
    update();
  }
</script>

<style>
  .dd-track {
    --clutter: 0;
    --reader: 0;
    --ruler: 0;
    --symbols: 0;
    position: relative;
    height: 260vh;
  }
  .dd-track.is-static { height: auto; }
  .dd-sticky {
    position: sticky;
    top: 5rem;
    display: grid;
    gap: 1.25rem;
    padding-block: 1rem;
  }
  .is-static .dd-sticky { position: static; }

  /* Step list */
  .dd-steps {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.55);
  }
  .dd-step { display: flex; align-items: center; gap: 0.5rem; transition: color 0.3s; }
  .dd-step-num {
    display: inline-grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    font-size: 0.75rem;
    transition: background-color 0.3s, border-color 0.3s, color 0.3s;
  }
  .dd-step.is-done { color: rgba(255, 255, 255, 0.85); }
  .dd-step.is-done .dd-step-num { background: #6DD9A8; border-color: #6DD9A8; color: #0D1F3C; font-weight: 600; }
  .dd-step.is-current { color: #fff; }

  /* Browser frame */
  .dd-browser {
    max-width: 56rem;
    width: 100%;
    margin-inline: auto;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #fff;
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(91, 155, 248, calc(var(--symbols) * 0.35));
  }
  .dd-chrome {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    background: #E8EBF0;
    border-bottom: 1px solid #D5DAE1;
  }
  .dd-dots { display: flex; gap: 6px; }
  .dd-dots i { width: 10px; height: 10px; border-radius: 9999px; background: #C3C9D2; }
  .dd-url {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding: 0.2rem 0.75rem;
    border-radius: 9999px;
    background: #fff;
    color: #5B6472;
    font-size: 0.75rem;
  }

  /* Page */
  .dd-page {
    position: relative;
    height: min(60vh, 30rem);
    overflow: hidden;
    color: #3d3d3d;
    font-family: Georgia, 'Times New Roman', serif;
  }
  .dd-clutter {
    opacity: calc(1 - var(--clutter));
    transform: scale(calc(1 - var(--clutter) * 0.06));
  }
  .dd-banner {
    background: #E5243B;
    color: #fff;
    font: 700 0.8rem/1 system-ui, sans-serif;
    letter-spacing: 0.08em;
    text-align: center;
    padding: calc(0.7rem * (1 - var(--clutter))) 0;
    height: calc(2.3rem * (1 - var(--clutter)));
    overflow: hidden;
  }
  .dd-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) calc((1 - var(--clutter)) * 30%);
    height: 100%;
  }
  .dd-side {
    padding: 1rem;
    border-left: 1px solid #eee;
    overflow: hidden;
    font: 0.75rem/1.3 system-ui, sans-serif;
  }
  .dd-ad {
    display: grid;
    place-items: center;
    text-align: center;
    height: 5rem;
    margin-bottom: 0.75rem;
    padding: 0.5rem;
    background: repeating-linear-gradient(45deg, #FFE7A3, #FFE7A3 10px, #FFD86B 10px, #FFD86B 20px);
    color: #6b4b00;
    font-weight: 700;
  }
  .dd-ad--tall { height: 7rem; background: #222; color: #bbb; }
  .dd-trending { font-weight: 700; margin-bottom: 0.4rem; color: #222; }
  .dd-side ul { display: grid; gap: 0.4rem; }
  .dd-side li { height: 0.55rem; border-radius: 3px; background: #e6e6e6; }

  /* Article: dense and grey, turning into Reading Mode */
  .dd-article {
    position: relative;
    overflow: hidden;
    padding: 1.25rem calc(1.25rem + var(--reader) * 6%);
  }
  .dd-reader-bg {
    position: absolute;
    inset: 0;
    background: #FBF6EA;
    opacity: var(--reader);
  }
  .dd-article > :not(.dd-reader-bg):not(.dd-ruler) { position: relative; }
  .dd-kicker {
    font: 600 0.7rem/1 system-ui, sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #E5243B;
    opacity: calc(1 - var(--reader) * 0.6);
    margin-bottom: 0.5rem;
  }
  .dd-title {
    font-size: calc(1.15rem + var(--reader) * 0.35rem);
    line-height: 1.25;
    color: #111;
    margin-bottom: 0.75rem;
  }
  .dd-text {
    font-size: calc(0.8rem + var(--reader) * 0.25rem);
    line-height: calc(1.45 + var(--reader) * 0.5);
    letter-spacing: calc(var(--reader) * 0.01em);
    color: rgb(calc(90 - var(--reader) * 62) calc(90 - var(--reader) * 62) calc(90 - var(--reader) * 62));
    font-family: system-ui, sans-serif;
  }

  /* Reading ruler: a soft band with the rest of the page dimmed */
  .dd-ruler {
    position: absolute;
    left: 0;
    right: 0;
    top: 46%;
    height: 2.4em;
    font-size: calc(0.8rem + var(--reader) * 0.25rem);
    background: rgba(91, 155, 248, 0.12);
    border-block: 2px solid rgba(91, 155, 248, 0.55);
    box-shadow: 0 0 0 100vmax rgba(13, 31, 60, 0.07);
    opacity: var(--ruler);
    transform: translateX(calc((1 - var(--ruler)) * -12%));
    z-index: 1;
    pointer-events: none;
  }

  /* AAC symbols above key words */
  /* Like ruby text: each symbol word grows top padding and the picture sits in
     it, so pictures never cover the line above */
  .dd-text :global(.dd-w) {
    position: relative;
    display: inline-block;
    line-height: 1.2;
    padding-top: calc(var(--symbols) * 1.95em);
  }
  .dd-text :global(.dd-pic) {
    position: absolute;
    left: 50%;
    top: 0;
    width: 1.75em;
    height: 1.75em;
    margin-left: -0.875em;
    padding: 2px;
    border-radius: 6px;
    background: #fff;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
    opacity: var(--symbols);
    transform: translateY(calc((1 - var(--symbols)) * 6px)) scale(calc(0.6 + var(--symbols) * 0.4));
    transform-origin: 50% 100%;
  }

  /* Pop-up and cookie bar */
  .dd-popup {
    position: absolute;
    top: 22%;
    left: 50%;
    width: min(18rem, 80%);
    translate: -50% 0;
    padding: 1.25rem;
    border-radius: 0.75rem;
    background: #fff;
    box-shadow: 0 0 0 100vmax rgba(0, 0, 0, calc(0.35 * (1 - var(--clutter)))), 0 20px 40px rgba(0, 0, 0, 0.3);
    font: 0.85rem/1.4 system-ui, sans-serif;
    text-align: center;
    z-index: 3;
  }
  .dd-popup-title { font-weight: 800; font-size: 1.1rem; color: #111; margin-bottom: 0.25rem; }
  .dd-popup-btn, .dd-cookie-btn {
    display: inline-block;
    margin-top: 0.75rem;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    background: #E5243B;
    color: #fff;
    font-weight: 700;
  }
  .dd-cookie {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding: 0.75rem 1rem;
    background: #1F2430;
    color: #ddd;
    font: 0.75rem/1.3 system-ui, sans-serif;
    z-index: 2;
  }
  .dd-cookie-btn { margin: 0; background: #2F6FE4; }

  @media (max-width: 640px) {
    .dd-track { height: 240vh; }
    .dd-page { height: min(62vh, 28rem); }
    .dd-layout { grid-template-columns: minmax(0, 1fr) calc((1 - var(--clutter)) * 34%); }
    .dd-ad { height: 3.5rem; font-size: 0.65rem; }
    .dd-ad--tall { height: 4.5rem; }
    .dd-steps { font-size: 0.75rem; gap: 0.4rem 0.75rem; }
  }
</style>
