---
const links = [
  { href: '/docs/getting-started/', label: 'Docs' },
  { href: '/roadmap/', label: 'Roadmap' },
  { href: '/install/', label: 'Install' },
];

const current = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-40">
  <!-- Blur backdrop -->
  <div class="absolute inset-0 bg-navy-900/80 backdrop-blur-md border-b border-white/5" />

  <nav class="relative max-w-6xl mx-auto px-6 h-16 flex items-center justify-between" aria-label="Main navigation">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-3 group" aria-label="ClearPath home">
      <!-- Inline (not <img>) so the first-visit draw-in can animate the strokes -->
      <svg class="cp-logo transition-transform group-hover:scale-110" viewBox="62 74 330 364" width="26" height="28" aria-hidden="true" focusable="false">
        <defs>
          <linearGradient id="cp-nav-g" gradientUnits="userSpaceOnUse" x1="120" y1="400" x2="380" y2="110"><stop offset="0" stop-color="#5B9BF8"/><stop offset="1" stop-color="#6DD9A8"/></linearGradient>
        </defs>
        <path class="cp-arc" d="M 334 154 A 136 136 0 1 0 334 358" pathLength="1" fill="none" stroke="url(#cp-nav-g)" stroke-width="56" stroke-linecap="round"/>
        <g class="cp-dot"><circle cx="334" cy="358" r="40" fill="#5B9BF8"/><circle cx="334" cy="358" r="16" fill="#0D1F3C"/></g>
        <polyline class="cp-chevron" points="292,206 352,256 292,306" pathLength="1" fill="none" stroke="#6DD9A8" stroke-width="44" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <span class="font-display text-lg text-white">ClearPath</span>
    </a>

    <!-- Links -->
    <ul class="hidden md:flex items-center gap-6 lg:gap-8 lg:absolute lg:left-1/2 lg:-translate-x-1/2" role="list">
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            class:list={[
              'text-sm font-medium transition-colors',
              current.startsWith(href)
                ? 'text-brand-blue'
                : 'text-white/75 hover:text-white',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>

    <!-- CTA -->
    <div class="flex items-center gap-3">
      <button type="button" class="motion-toggle" data-motion-toggle aria-pressed="false" aria-label="Reduce motion" title="Pause animations">
        <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1.2"/><rect x="14" y="5" width="4" height="14" rx="1.2"/></svg>
        <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.6v12.8a1 1 0 0 0 1.53.85l10.1-6.4a1 1 0 0 0 0-1.7l-10.1-6.4A1 1 0 0 0 8 5.6Z"/></svg>
      </button>
      <a
        href="https://github.com/clearpath-ext/clearpath-extension"
        class="hidden md:flex items-center gap-2 text-sm text-white/75 hover:text-white transition-colors"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View on GitHub (opens in new tab)"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        GitHub
      </a>
      <a
        href="/install/"
        class="px-4 py-2 rounded-lg text-sm font-medium bg-brand-gradient text-navy-900 hover:opacity-90 transition-opacity"
      >
        Get ClearPath
      </a>
    </div>
  </nav>
</header>
