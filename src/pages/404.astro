---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Page not found" description="This page doesn't exist. Head back to ClearPath's homepage, docs, or install guide.">
  <Nav />

  <main id="main-content" class="pt-40 pb-32">
    <div class="max-w-xl mx-auto px-6 text-center">
      <img src="/clearpath-mark.svg" alt="" width="72" height="80" class="mx-auto mb-8 opacity-90" />
      <p class="text-brand-green font-mono text-sm mb-3">404</p>
      <h1 class="font-display text-5xl text-white mb-4">This path doesn't go anywhere.</h1>
      <p class="text-white/60 leading-relaxed mb-10">
        The page you're looking for doesn't exist or has moved. These will get you back on track:
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 whitespace-nowrap">
        <a href="/" class="px-6 py-3 rounded-xl font-semibold text-navy-900 bg-brand-gradient hover:opacity-90 transition-opacity w-full sm:w-auto">
          Homepage
        </a>
        <a href="/docs/getting-started/" class="px-6 py-3 rounded-xl font-medium text-white border border-white/10 hover:border-white/20 transition-all w-full sm:w-auto">
          Docs
        </a>
        <a href="/install/" class="px-6 py-3 rounded-xl font-medium text-brand-blue hover:text-brand-green transition-colors w-full sm:w-auto">
          Install guide →
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Base>
