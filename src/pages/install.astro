---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base
  title="Install"
  description="Download ClearPath for Chrome, Edge, Brave, Arc and Opera. Free, no account required."
>
  <Nav />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-3xl mx-auto px-6">

      <div class="text-center mb-16">
        <h1 class="font-display text-5xl text-white mb-4">Install ClearPath</h1>
        <p class="text-white/75 text-lg">Free. No account. Works immediately.</p>
      </div>

      <!-- Demo loop: the real extension on a sample news page. Plays muted
           while on screen (and not when animations are paused), with its own
           pause button. -->
      <figure class="mb-16">
        <div class="relative gradient-border rounded-2xl overflow-hidden bg-navy-800 shadow-[0_30px_80px_-30px_rgba(91,155,248,0.45)]">
          <video
            id="install-demo"
            class="block w-full h-auto"
            width="1280"
            height="620"
            poster="/video/clearpath-demo-poster.webp"
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="ClearPath on a news article: AAC symbols appear above key words, Reading Mode strips the page down to the article, the reading ruler follows the cursor, and read aloud highlights each word."
          >
            <source src="/video/clearpath-demo.mp4" type="video/mp4" />
          </video>
          <button
            id="install-demo-toggle"
            type="button"
            class="absolute right-3 bottom-3 inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium text-white bg-navy-900/80 border border-white/15 backdrop-blur hover:bg-navy-900 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue"
          >
            <svg class="demo-icon-pause" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1.2"/><rect x="14" y="5" width="4" height="14" rx="1.2"/></svg>
            <svg class="demo-icon-play hidden" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.6v12.8a1 1 0 0 0 1.53.85l10.1-6.4a1 1 0 0 0 0-1.7l-10.1-6.4A1 1 0 0 0 8 5.6Z"/></svg>
            <span class="demo-label">Pause</span>
          </button>
        </div>
        <figcaption class="mt-3 text-center text-sm text-white/60">
          The real extension on a sample news page: AAC symbols, Reading Mode, the reading ruler and read aloud.
        </figcaption>
      </figure>

      <script>
        const video = document.getElementById('install-demo') as HTMLVideoElement | null;
        const toggle = document.getElementById('install-demo-toggle');
        if (video && toggle) {
          const reduced = () => (window as any).isMotionReduced?.() === true;
          let userPaused = false;
          let onScreen = false;

          const render = () => {
            const playing = !video.paused;
            toggle.querySelector('.demo-label')!.textContent = playing ? 'Pause' : 'Play';
            toggle.querySelector('.demo-icon-pause')!.classList.toggle('hidden', !playing);
            toggle.querySelector('.demo-icon-play')!.classList.toggle('hidden', playing);
            toggle.setAttribute('aria-label', playing ? 'Pause demo video' : 'Play demo video');
          };
          const sync = () => {
            if (onScreen && !userPaused && !reduced()) video.play().catch(() => {});
            else video.pause();
          };

          video.addEventListener('play', render);
          video.addEventListener('pause', render);
          toggle.addEventListener('click', () => {
            userPaused = !video.paused;
            if (userPaused) video.pause();
            else video.play().catch(() => {});
          });
          // Pausing animations site-wide pauses the video too; unpausing lets it play again
          document.addEventListener('motionchange', () => { userPaused = false; sync(); });
          new IntersectionObserver(([entry]) => { onScreen = entry.isIntersecting; sync(); }, { threshold: 0.35 }).observe(video);
          render();
        }
      </script>

      <!-- Browser options -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-16 items-stretch">

        <!-- Chrome -->
        <div class="p-8 rounded-2xl bg-navy-800/40 border border-white/5 hover:border-brand-blue/30 transition-colors group flex flex-col">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-white/5 flex items-center justify-center" aria-hidden="true">
              <img src="/chrome.svg" alt="" width="32" height="32" />
            </div>
            <div>
              <h2 class="font-semibold text-white text-lg">Chrome</h2>
              <p class="text-white/75 text-sm">Also works on Edge, Brave, Arc, Opera</p>
            </div>
          </div>
          <!-- releases/latest/download/clearpath-chrome.zip always serves the newest
               release (the release workflow attaches an unversioned copy) -->
          <a
            href="https://github.com/clearpath-ext/clearpath-extension/releases/latest/download/clearpath-chrome.zip"
            class="flex items-center justify-center gap-2 w-full py-3 rounded-xl font-semibold text-navy-900 bg-brand-gradient hover:opacity-90 transition-opacity mt-auto focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy-800"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/></svg>
            Download for Chrome (.zip)
          </a>
          <p class="text-white/75 text-xs text-center mt-3 md:min-h-12">
            Takes a minute: <a href="#install-download" class="text-brand-blue hover:text-brand-green transition-colors">see the steps below</a>.
            <a href="https://github.com/clearpath-ext/clearpath-extension/releases/latest" target="_blank" rel="noopener noreferrer" class="text-brand-blue hover:text-brand-green transition-colors">Release notes</a>.
            The Chrome Web Store listing is <a href="/roadmap/" class="text-brand-blue hover:text-brand-green transition-colors">planned for v1.0</a>.
          </p>
        </div>

        <!-- Firefox -->
        <div class="p-8 rounded-2xl bg-navy-800/40 border border-white/5 hover:border-brand-green/30 transition-colors group flex flex-col">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-12 h-12 rounded-xl bg-white/5 flex items-center justify-center" aria-hidden="true">
              <img src="/firefox.svg" alt="" width="32" height="32" />
            </div>
            <div>
              <h2 class="font-semibold text-white text-lg">Firefox</h2>
              <p class="text-white/75 text-sm">Full feature parity is planned, after Chrome ships</p>
            </div>
          </div>
          <a
            href="#notify-heading"
            class="flex items-center justify-center gap-2 w-full py-3 rounded-xl font-semibold text-white border border-white/15 hover:border-white/30 transition-colors mt-auto focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue"
          >
            Firefox Add-ons — After v1.0
          </a>
          <p class="text-white/75 text-xs text-center mt-3 md:min-h-12">
            Not ready yet. Leave your email below to hear when it is.
          </p>
        </div>

      </div>

      <!-- Installing the download -->
      <section id="install-download" class="mb-16 -mt-6 scroll-mt-28" aria-labelledby="install-download-heading">
        <h2 id="install-download-heading" class="font-display text-2xl text-white mb-2">Installing the download</h2>
        <p class="text-white/75 text-sm mb-6">Until the Chrome Web Store listing (planned for v1.0), ClearPath installs from the zip. It works the same way in Edge, Brave, Arc and Opera.</p>
        <ol class="space-y-5">
          {[
            { title: 'Unzip it', body: 'Open the downloaded clearpath-chrome.zip so you have a folder. Keep that folder somewhere it won\'t be deleted, like Documents: the browser runs ClearPath from it.' },
            { title: 'Turn on Developer mode', body: 'Type chrome://extensions in the address bar (edge://extensions in Edge) and switch on Developer mode in the top-right corner.' },
            { title: 'Load it', body: 'Click Load unpacked and choose the unzipped folder. ClearPath appears in your extensions; pin it so it\'s one click away.' },
          ].map(({ title, body }, i) => (
            <li class="flex gap-5">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-gradient flex items-center justify-center text-navy-900 font-bold text-sm" aria-hidden="true">{i + 1}</div>
              <div>
                <h3 class="font-semibold text-white mb-1"><span class="sr-only">Step {i + 1}: </span>{title}</h3>
                <p class="text-white/75 text-sm leading-relaxed">{body}</p>
              </div>
            </li>
          ))}
        </ol>
        <p class="text-white/75 text-sm mt-6">
          <strong class="text-white font-semibold">Updating:</strong> a downloaded copy doesn't update itself. When a new version is out, download the zip again, replace the folder's contents, and click the reload arrow on ClearPath's card in your extensions page. Your settings stay. The store version, once it's live, will update automatically.
        </p>
      </section>

      <!-- Notify me -->
      <div class="p-6 rounded-2xl bg-navy-800/40 border border-white/5 mb-16 scroll-mt-28">
        <h2 id="notify-heading" class="font-semibold text-white mb-1">Get notified at launch</h2>
        <p class="text-white/75 text-sm mb-4">
          ClearPath is launching on Chrome first, with full Firefox support to follow. Leave your email and we'll let you know the moment either store listing goes live — nothing else, ever.
        </p>

        <form id="notify-form" class="flex flex-col sm:flex-row gap-3" novalidate>
          <label for="notify-email" class="sr-only">Email address</label>
          <input
            id="notify-email"
            name="email"
            type="email"
            required
            placeholder="you@example.com"
            autocomplete="email"
            class="flex-1 px-4 py-3 rounded-lg bg-navy-900 border border-white/10 text-white text-sm placeholder:text-white/50 focus:outline-none focus:ring-2 focus:ring-brand-blue"
          />
          <!-- Honeypot — hidden from sighted and AT users, real visitors never fill it in -->
          <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
          <button
            type="submit"
            class="px-6 py-3 rounded-lg font-semibold text-navy-900 bg-brand-gradient hover:opacity-90 transition-opacity text-sm whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue focus-visible:ring-offset-2 focus-visible:ring-offset-navy-800"
          >
            Notify me
          </button>
        </form>
        <p id="notify-status" class="text-sm mt-3" role="status" aria-live="polite"></p>

        <p class="text-white/75 text-xs mt-2">
          Prefer not to share your email? <a href="https://github.com/clearpath-ext/clearpath-extension" target="_blank" rel="noopener noreferrer" class="text-brand-blue hover:text-brand-green transition-colors">Watch the repo on GitHub</a> instead.
        </p>
      </div>

      <script>
        const form = document.getElementById('notify-form') as HTMLFormElement | null;
        const status = document.getElementById('notify-status');

        form?.addEventListener('submit', async (e) => {
          e.preventDefault();
          if (!status) return;

          const formData = new FormData(form);
          const email = String(formData.get('email') ?? '').trim();
          const website = String(formData.get('website') ?? '');

          const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
          if (submitBtn) submitBtn.disabled = true;
          status.textContent = 'Sending…';
          status.className = 'text-sm mt-3 text-white/75';

          try {
            const res = await fetch('/api/notify', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ email, website }),
            });
            const data = await res.json().catch(() => ({}));

            if (res.ok) {
              status.textContent = "You're on the list — we'll email you at launch.";
              status.className = 'text-sm mt-3 text-brand-green';
              form.reset();
            } else {
              status.textContent = data.error || 'Something went wrong — please try again.';
              status.className = 'text-sm mt-3 text-red-400';
            }
          } catch {
            status.textContent = 'Something went wrong — please try again.';
            status.className = 'text-sm mt-3 text-red-400';
          } finally {
            if (submitBtn) submitBtn.disabled = false;
          }
        });
      </script>

      <!-- After install steps -->
      <div class="mb-16">
        <h2 class="font-display text-2xl text-white mb-8">After installing</h2>
        <ol class="space-y-6">
          {[
            {
              step: '1',
              title: 'Pin the extension',
              body: 'Click the puzzle piece icon in the toolbar, find ClearPath, and click the pin icon. That puts the ClearPath icon in your toolbar for quick access.',
            },
            {
              step: '2',
              title: 'Try Read Aloud immediately',
              body: 'Select any text on a webpage, right-click, and choose "Read Aloud." No setup needed — it works right away using your browser\'s built-in voice.',
            },
            {
              step: '3',
              title: 'Explore the popup',
              body: 'Click the ClearPath icon in your toolbar to open the control panel. From here you can toggle Reading Mode, adjust your settings, and manage profiles.',
            },
            {
              step: '4',
              title: 'Set up Simplify (optional)',
              body: 'To use the Simplify feature, you\'ll need an LLM API key. This is optional — all other features work without it.',
            },
          ].map(({ step, title, body }) => (
            <li class="flex gap-5">
              <div class="flex-shrink-0 w-8 h-8 rounded-full bg-brand-gradient flex items-center justify-center text-navy-900 font-bold text-sm" aria-label={`Step ${step}`}>
                {step}
              </div>
              <div>
                <h3 class="font-semibold text-white mb-1">{title}</h3>
                <p class="text-white/75 text-sm leading-relaxed">{body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- API setup CTA -->
      <div class="p-6 rounded-xl bg-brand-blue/5 border border-brand-blue/20">
        <h3 class="font-semibold text-white mb-2">Want to use Simplify?</h3>
        <p class="text-white/75 text-sm mb-4">
          Simplify uses an LLM to rewrite text in plain language. You bring your own API key — your text goes directly to your provider.
        </p>
        <a href="/docs/api-setup/" class="text-brand-blue text-sm font-medium hover:text-brand-green transition-colors">
          API setup guide →
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Base>
