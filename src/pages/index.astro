---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base title="The web, on your terms">
  <Nav />

  <main id="main-content">

    <!-- ===================== HERO ===================== -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-16">

      <!-- Background radial glow -->
      <div class="absolute inset-0 bg-hero-gradient pointer-events-none" aria-hidden="true" />

      <!-- Subtle grid -->
      <div
        class="absolute inset-0 opacity-[0.03]"
        style="background-image: linear-gradient(rgba(91,155,248,1) 1px, transparent 1px), linear-gradient(90deg, rgba(91,155,248,1) 1px, transparent 1px); background-size: 48px 48px;"
        aria-hidden="true"
      />

      <div class="relative max-w-5xl mx-auto px-6 py-32 text-center">

        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-brand-blue/30 bg-brand-blue/5 text-brand-blue text-sm font-medium mb-8 animate-fade-in">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-blue" aria-hidden="true" />
          Free & open source · No account required
        </div>

        <!-- Headline -->
        <h1 class="font-display text-5xl md:text-7xl text-white leading-[1.1] mb-6 animate-fade-up delay-100">
          The web,<br />
          <em class="gradient-text not-italic">on your terms.</em>
        </h1>

        <!-- Subhead -->
        <p class="text-lg md:text-xl text-white/60 max-w-2xl mx-auto leading-relaxed mb-10 animate-fade-up delay-200">
          ClearPath is a browser extension that simplifies text, reads pages aloud with word highlighting,
          and displays AAC symbols — so anyone can access any website.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-up delay-300">
          <a
            href="/install"
            class="px-8 py-4 rounded-xl font-semibold text-navy-900 bg-brand-gradient hover:opacity-90 transition-opacity text-base w-full sm:w-auto"
          >
            Install for Chrome — Free
          </a>
          <a
            href="https://github.com/clearpath-ext/clearpath-extension"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-xl font-medium text-white/70 border border-white/10 hover:border-white/20 hover:text-white transition-all text-base w-full sm:w-auto gradient-border"
          >
            View on GitHub
          </a>
        </div>

        <!-- Social proof -->
        <p class="mt-8 text-sm text-white/30 animate-fade-up delay-400">
          Firefox support planned · No data collected · MIT License
        </p>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-fade-in delay-500" aria-hidden="true">
        <span class="text-xs text-white/20 tracking-widest uppercase">Scroll</span>
        <div class="w-px h-12 bg-gradient-to-b from-white/20 to-transparent" />
      </div>
    </section>


    <!-- ===================== PROBLEM / INSIGHT ===================== -->
    <section class="max-w-4xl mx-auto px-6 py-24 text-center">
      <p class="font-display text-3xl md:text-4xl text-white/90 leading-relaxed animate-fade-up">
        The web was built for people who read dense text quickly. That's not everyone.
      </p>
      <p class="mt-6 text-white/50 text-lg max-w-2xl mx-auto animate-fade-up delay-100">
        AAC users, people with dyslexia, cognitive disabilities, acquired brain injuries —
        millions of people face a web that wasn't designed with them in mind.
        ClearPath changes that, on any site, right now.
      </p>
    </section>


    <!-- ===================== DEMO ===================== -->
    <section class="max-w-4xl mx-auto px-6 py-16" aria-labelledby="demo-heading">
      <div class="text-center mb-10">
        <h2 id="demo-heading" class="font-display text-3xl md:text-4xl text-white mb-3 animate-fade-up">
          See it work.
        </h2>
        <p class="text-white/50 animate-fade-up delay-100">
          A real example of the kind of text ClearPath rewrites — try the toggle.
        </p>
      </div>

      <div class="rounded-2xl border border-white/5 bg-navy-800/30 overflow-hidden animate-fade-up delay-200">
        <div class="flex items-center justify-center gap-1 p-3 border-b border-white/5" role="group" aria-label="Demo view">
          <button
            id="demo-before-btn"
            type="button"
            aria-pressed="true"
            class="px-4 py-1.5 rounded-lg text-sm font-medium transition-colors bg-white/10 text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue"
          >
            Before
          </button>
          <button
            id="demo-after-btn"
            type="button"
            aria-pressed="false"
            class="px-4 py-1.5 rounded-lg text-sm font-medium transition-colors text-white/50 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue"
          >
            With ClearPath
          </button>
        </div>

        <div class="p-8 md:p-10 min-h-[220px] flex items-center">
          <div id="demo-before-panel" class="w-full">
            <p class="text-white/60 leading-relaxed">
              Applicants must submit all requisite documentation prior to the commencement of the
              eligibility determination process. Failure to comply with the aforementioned
              requirements may result in the forfeiture of benefits.
            </p>
          </div>

          <div id="demo-after-panel" class="w-full" hidden>
            <div class="flex items-center gap-2 mb-5 text-brand-blue text-sm font-medium" aria-hidden="true">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-blue opacity-75" />
                <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-blue" />
              </span>
              Reading aloud
            </div>
            <p id="demo-words" class="text-white text-xl md:text-2xl leading-relaxed tracking-wide">
              {[
                'You', 'must', 'send', 'your', 'papers', 'before', 'we', 'check', 'if', 'you',
                'qualify.', 'If', 'you', "don't", 'send', 'them,', 'you', 'may', 'lose', 'your', 'benefits.',
              ].map((word) => (
                <span class="demo-word rounded transition-colors duration-150">{word}{' '}</span>
              ))}
            </p>
          </div>
        </div>
      </div>
    </section>

    <script>
      const beforeBtn = document.getElementById('demo-before-btn');
      const afterBtn = document.getElementById('demo-after-btn');
      const beforePanel = document.getElementById('demo-before-panel');
      const afterPanel = document.getElementById('demo-after-panel');
      const words = Array.from(document.querySelectorAll('#demo-words .demo-word'));

      let highlightTimer: ReturnType<typeof setInterval> | null = null;
      let wordIndex = 0;

      function clearHighlight() {
        words.forEach((w) => w.classList.remove('bg-brand-blue/30'));
      }

      function startHighlight() {
        if (highlightTimer || words.length === 0) return;
        wordIndex = 0;
        highlightTimer = setInterval(() => {
          clearHighlight();
          words[wordIndex]?.classList.add('bg-brand-blue/30');
          wordIndex = (wordIndex + 1) % words.length;
        }, 320);
      }

      function stopHighlight() {
        if (highlightTimer) {
          clearInterval(highlightTimer);
          highlightTimer = null;
        }
        clearHighlight();
      }

      function showAfter() {
        beforePanel?.setAttribute('hidden', '');
        afterPanel?.removeAttribute('hidden');
        beforeBtn?.setAttribute('aria-pressed', 'false');
        afterBtn?.setAttribute('aria-pressed', 'true');
        beforeBtn?.classList.remove('bg-white/10', 'text-white');
        beforeBtn?.classList.add('text-white/50');
        afterBtn?.classList.add('bg-white/10', 'text-white');
        afterBtn?.classList.remove('text-white/50');
        startHighlight();
      }

      function showBefore() {
        afterPanel?.setAttribute('hidden', '');
        beforePanel?.removeAttribute('hidden');
        afterBtn?.setAttribute('aria-pressed', 'false');
        beforeBtn?.setAttribute('aria-pressed', 'true');
        afterBtn?.classList.remove('bg-white/10', 'text-white');
        afterBtn?.classList.add('text-white/50');
        beforeBtn?.classList.add('bg-white/10', 'text-white');
        beforeBtn?.classList.remove('text-white/50');
        stopHighlight();
      }

      beforeBtn?.addEventListener('click', showBefore);
      afterBtn?.addEventListener('click', showAfter);
    </script>


    <!-- ===================== FEATURES ===================== -->
    <section class="max-w-6xl mx-auto px-6 py-16" aria-labelledby="features-heading">
      <div class="text-center mb-16">
        <h2 id="features-heading" class="font-display text-4xl md:text-5xl text-white mb-4 animate-fade-up">
          Everything you need.<br /><span class="gradient-text">Nothing you don't.</span>
        </h2>
        <p class="text-white/50 max-w-xl mx-auto animate-fade-up delay-100">
          Seven focused tools that work on any website, with no account or setup required.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">

        {[
          {
            icon: '🔊',
            title: 'Read Aloud',
            desc: 'Text-to-speech with word-by-word highlighting, built into every page. Configure voice, speed, and pitch. Works offline.',
            color: 'from-blue-500/10',
          },
          {
            icon: '🧠',
            title: 'Simplify',
            desc: 'Right-click any text and rewrite it in plain English at Grade 3, 5, or 8 level. Powered by your choice of LLM — OpenAI, Anthropic, or a fully local Ollama model. Requires your own API key.',
            color: 'from-green-500/10',
          },
          {
            icon: '📖',
            title: 'Reading Mode',
            desc: 'Strip pages down to their content. Apply OpenDyslexic font, adjust spacing and column width, choose from four colour themes.',
            color: 'from-purple-500/10',
          },
          {
            icon: '🖼️',
            title: 'Symbol Overlay',
            desc: 'Display AAC pictogram symbols above words using the open ARASAAC library. Built for AAC users and the people who support them.',
            color: 'from-amber-500/10',
          },
          {
            icon: '🎯',
            title: 'Focus Tools',
            desc: 'Reading ruler that follows your cursor. Paragraph focus mode. Word complexity highlighting with simpler alternatives on hover.',
            color: 'from-pink-500/10',
          },
          {
            icon: '👤',
            title: 'Profiles',
            desc: 'Save accessibility settings as named profiles and share them as JSON. Perfect for SLPs configuring settings for a client.',
            color: 'from-cyan-500/10',
          },
          {
            icon: '📚',
            title: 'Vocabulary',
            desc: 'Double-click any word for an instant plain-English definition. Powered by a bundled offline dictionary — no API key, no internet required.',
            color: 'from-rose-500/10',
          },
        ].map(({ icon, title, desc, color }) => (
          <div class:list={[
            'relative p-6 rounded-2xl bg-gradient-to-br to-transparent border border-white/5',
            'hover:border-white/10 transition-colors group animate-fade-up',
            color,
          ]}>
            <div class="text-3xl mb-4" aria-hidden="true">{icon}</div>
            <h3 class="font-semibold text-white text-lg mb-2">{title}</h3>
            <p class="text-white/50 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}

      </div>

      <div class="text-center mt-10">
        <a href="/docs/getting-started" class="text-brand-blue hover:text-brand-green transition-colors text-sm font-medium">
          Read the docs →
        </a>
      </div>
    </section>


    <!-- ===================== WHO IT'S FOR ===================== -->
    <section class="py-24 border-y border-white/5" aria-labelledby="who-heading">
      <div class="max-w-6xl mx-auto px-6">
        <h2 id="who-heading" class="font-display text-4xl text-white text-center mb-12 animate-fade-up">
          Built for real people.
        </h2>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {[
            { group: 'AAC users', detail: 'Symbols + simplification on any website' },
            { group: 'Dyslexia', detail: 'OpenDyslexic font, reading ruler, TTS' },
            { group: 'Cognitive disabilities', detail: 'Plain language, reduced complexity' },
            { group: 'SLPs & caregivers', detail: 'Shareable profiles for clients' },
          ].map(({ group, detail }) => (
            <div class="p-5 rounded-xl bg-navy-800/50 border border-white/5 animate-fade-up">
              <p class="font-semibold text-white text-sm mb-1">{group}</p>
              <p class="text-white/40 text-xs leading-relaxed">{detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>


    <!-- ===================== PRIVACY CALLOUT ===================== -->
    <section class="max-w-3xl mx-auto px-6 py-24 text-center">
      <div class="p-8 rounded-2xl bg-navy-800/30 border border-white/5 gradient-border animate-fade-up">
        <div class="text-4xl mb-4" aria-hidden="true">🔒</div>
        <h2 class="font-display text-3xl text-white mb-4">Your data goes nowhere.</h2>
        <p class="text-white/50 leading-relaxed">
          No analytics. No telemetry. No servers. All settings stay in your browser.
          If you use LLM features, text goes directly from your browser to your API provider — never through us.
          Everything is open source and auditable.
        </p>
        <a href="/privacy" class="inline-block mt-6 text-sm text-brand-blue hover:text-brand-green transition-colors">
          Read the privacy policy →
        </a>
      </div>
    </section>


    <!-- ===================== FAQ ===================== -->
    <section class="max-w-3xl mx-auto px-6 py-16" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="font-display text-4xl text-white text-center mb-12 animate-fade-up">
        Questions, answered.
      </h2>

      <div class="space-y-4">
        {[
          {
            q: 'Does ClearPath cost anything?',
            a: "No. ClearPath is completely free and open source — no subscription, no ads, no account, no trial that expires.",
          },
          {
            q: 'Will it slow down my browsing?',
            a: "No. ClearPath's features only activate when you use them — reading a page aloud, opening Reading Mode, and so on. There's no background analysis or network activity until you ask for it.",
          },
          {
            q: 'What data does ClearPath collect?',
            a: 'None. No analytics, no telemetry, no tracking of any kind. Settings are stored locally in your browser and synced only via your own browser account.',
          },
          {
            q: 'Do I need an account to use it?',
            a: 'No account, ever — for ClearPath itself. Install it and everything except Simplify works immediately.',
          },
          {
            q: 'Do I need an API key?',
            a: "Only for Simplify, which rewrites text using an LLM you bring your own API key for (OpenAI, Anthropic, or a local Ollama model). Read Aloud, Reading Mode, Focus Tools, Symbol Overlay, and Vocabulary all work without one.",
          },
          {
            q: 'Which browsers does it support?',
            a: 'Chrome today (also works on Edge, Brave, Arc, and Opera). Firefox support is planned, launching after Chrome.',
          },
        ].map(({ q, a }) => (
          <div class="p-5 rounded-xl bg-navy-800/40 border border-white/5 animate-fade-up">
            <h3 class="font-semibold text-white text-sm mb-2">{q}</h3>
            <p class="text-white/50 text-sm leading-relaxed">{a}</p>
          </div>
        ))}
      </div>
    </section>


    <!-- ===================== OPEN SOURCE CTA ===================== -->
    <section class="max-w-6xl mx-auto px-6 py-16 text-center">
      <h2 class="font-display text-4xl text-white mb-4 animate-fade-up">
        Community built.<br /><span class="gradient-text">Everyone welcome.</span>
      </h2>
      <p class="text-white/50 max-w-xl mx-auto mb-8 animate-fade-up delay-100">
        ClearPath is built and maintained by volunteers. Developers, designers, SLPs, and
        accessibility advocates all have a place here.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-up delay-200">
        <a
          href="https://github.com/clearpath-ext/clearpath-extension/blob/main/CONTRIBUTING.md"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 rounded-xl font-medium text-white border border-white/10 hover:border-white/20 transition-all"
        >
          Contributing guide
        </a>
        <a
          href="https://github.com/clearpath-ext/clearpath-extension/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 rounded-xl font-medium text-brand-blue hover:text-brand-green transition-colors"
        >
          Browse good first issues →
        </a>
      </div>
    </section>

  </main>

  <Footer />
</Base>
