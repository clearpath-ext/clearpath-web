---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import DeclutterDemo from '../components/DeclutterDemo.astro';
---

<Base title="The web, on your terms">
  <Nav />

  <main id="main-content">

    <!-- ===================== HERO ===================== -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-16">

      <!-- Background radial glow -->
      <div class="absolute inset-0 bg-hero-gradient pointer-events-none" aria-hidden="true" />

      <div class="relative max-w-5xl mx-auto px-6 py-32 text-center">

        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-brand-blue/30 bg-brand-blue/5 text-brand-blue text-sm font-medium mb-8 animate-fade-in">
          <span class="w-1.5 h-1.5 rounded-full bg-brand-blue" aria-hidden="true" />
          Free & open source · No account required
        </div>

        <!-- Headline -->
        <h1 class="font-display text-5xl md:text-7xl text-white leading-[1.1] mb-6 animate-fade-up delay-100">
          The web,<br />
          <em class="gradient-text not-italic">on your terms.</em>
        </h1>

        <!-- Subhead -->
        <p class="text-lg md:text-xl text-white/75 max-w-2xl mx-auto leading-relaxed mb-10 animate-fade-up delay-200">
          ClearPath is a browser extension that simplifies text, reads pages aloud with word highlighting,
          and displays AAC symbols — so anyone can access any website.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-up delay-300">
          <a
            href="/install/"
            class="px-8 py-4 rounded-xl font-semibold text-navy-900 bg-brand-gradient hover:opacity-90 transition-opacity text-base w-full sm:w-auto"
          >
            Get ClearPath — Free
          </a>
          <a
            href="https://github.com/clearpath-ext/clearpath-extension"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-xl font-medium text-white/70 border border-white/10 hover:border-white/20 hover:text-white transition-all text-base w-full sm:w-auto gradient-border"
          >
            View on GitHub
          </a>
        </div>

        <!-- Social proof -->
        <p class="mt-8 text-sm text-white/75 animate-fade-up delay-400">
          Firefox support planned · No data collected · MIT License
        </p>
      </div>

      <!-- Scroll indicator -->
      <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-fade-in delay-500" aria-hidden="true">
        <span class="text-xs text-white/75 tracking-widest uppercase">Scroll</span>
        <div class="w-px h-12 bg-gradient-to-b from-white/20 to-transparent" />
      </div>
    </section>


    <!-- ===================== PROBLEM / INSIGHT ===================== -->
    <section class="max-w-4xl mx-auto px-6 py-24 text-center">
      <p class="font-display text-3xl md:text-4xl text-white/90 leading-relaxed animate-fade-up">
        The web was built for people who read dense text quickly. That's not everyone.
      </p>
      <p class="mt-6 text-white/75 text-lg max-w-2xl mx-auto animate-fade-up delay-100">
        AAC users, people with dyslexia, cognitive disabilities, acquired brain injuries —
        millions of people face a web that wasn't designed with them in mind.
        ClearPath changes that, on any site, right now.
      </p>
    </section>


    <!-- ===================== SCROLL DEMO ===================== -->
    <DeclutterDemo />


    <!-- ===================== DEMO ===================== -->
    <section class="max-w-4xl mx-auto px-6 py-16" aria-labelledby="demo-heading">
      <div class="text-center mb-10">
        <h2 id="demo-heading" class="font-display text-3xl md:text-4xl text-white mb-3 animate-fade-up">
          See it work.
        </h2>
        <p class="text-white/75 animate-fade-up delay-100">
          A real example of the kind of text ClearPath rewrites — try the toggle.
        </p>
      </div>

      <div class="gradient-border rounded-2xl bg-navy-800/80 overflow-hidden shadow-[0_30px_80px_-30px_rgba(91,155,248,0.45)] animate-fade-up delay-200">
        <div class="flex items-center justify-center p-4 border-b border-white/10 bg-navy-900/40">
          <div class="inline-flex gap-1 p-1 rounded-xl bg-navy-950/70 border border-white/10" role="group" aria-label="Demo view">
          <button
            id="demo-before-btn"
            type="button"
            aria-pressed="true"
            class="px-5 py-2 rounded-lg text-sm font-medium transition-all bg-brand-gradient text-navy-900 font-semibold shadow-[0_4px_16px_-4px_rgba(91,155,248,0.6)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue"
          >
            Before
          </button>
          <button
            id="demo-after-btn"
            type="button"
            aria-pressed="false"
            class="px-5 py-2 rounded-lg text-sm font-medium transition-all text-white/75 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue"
          >
            With ClearPath
          </button>
          </div>
        </div>

        <div class="p-8 md:p-10 min-h-[220px] flex items-center">
          <div id="demo-before-panel" class="w-full">
            <p class="text-white/75 leading-relaxed">
              Applicants must submit all requisite documentation prior to the commencement of the
              eligibility determination process. Failure to comply with the aforementioned
              requirements may result in the forfeiture of benefits.
            </p>
          </div>

          <div id="demo-after-panel" class="w-full" hidden>
            <div class="flex items-center justify-between gap-4 mb-5">
              <div class="flex items-center gap-2 text-brand-blue text-sm font-medium" aria-hidden="true">
                <span class="relative flex h-2 w-2">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-blue opacity-75" />
                  <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-blue" />
                </span>
                Reading aloud
              </div>
              <button
                id="demo-replay-btn"
                type="button"
                class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-sm text-white/75 border border-white/10 hover:text-white hover:border-white/25 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
                Play again
              </button>
            </div>
            <!-- The highlight is one pill that glides from word to word, like the extension -->
            <p id="demo-words" class="relative isolate text-white text-xl md:text-2xl leading-relaxed tracking-wide">
              <span id="demo-glide" class="demo-glide" aria-hidden="true" />
              {[
                'You', 'must', 'send', 'your', 'papers', 'before', 'we', 'check', 'if', 'you',
                'qualify.', 'If', 'you', "don't", 'send', 'them,', 'you', 'may', 'lose', 'your', 'benefits.',
              ].map((word) => (
                <span class="demo-word">{word}{' '}</span>
              ))}
            </p>
          </div>
        </div>
      </div>
    </section>

    <script>
      const beforeBtn = document.getElementById('demo-before-btn');
      const afterBtn = document.getElementById('demo-after-btn');
      const beforePanel = document.getElementById('demo-before-panel');
      const afterPanel = document.getElementById('demo-after-panel');
      const words = Array.from(
        document.querySelectorAll<HTMLElement>('#demo-words .demo-word'),
      );

      const supportsSpeech = 'speechSynthesis' in window;
      let fallbackTimer: ReturnType<typeof setInterval> | null = null;
      let fallbackStartTimer: ReturnType<typeof setTimeout> | null = null;
      let wordIndex = 0;

      const glide = document.getElementById('demo-glide');

      function clearHighlight() {
        glide?.classList.remove('is-on');
      }

      // Move the pill over word i. The trailing space is part of each span,
      // so measure the text node's first glyphs only via a Range.
      function highlightWord(i: number) {
        const word = words[i];
        const box = word?.parentElement?.getBoundingClientRect();
        if (!word || !glide || !box) return;
        const range = document.createRange();
        const text = word.firstChild;
        if (!text) return;
        range.setStart(text, 0);
        range.setEnd(text, (text.textContent ?? '').trimEnd().length);
        const r = range.getBoundingClientRect();
        glide.style.transform = `translate(${r.left - box.left - 4}px, ${r.top - box.top - 2}px)`;
        glide.style.width = `${r.width + 8}px`;
        glide.style.height = `${r.height + 4}px`;
        glide.classList.add('is-on');
      }

      function stopFallback() {
        if (fallbackTimer) {
          clearInterval(fallbackTimer);
          fallbackTimer = null;
        }
      }

      // Timed sweep — used when speech synthesis is unavailable, or as a
      // graceful fallback when a browser/voice doesn't fire word boundaries.
      function startFallback() {
        stopFallback();
        wordIndex = 0;
        fallbackTimer = setInterval(() => {
          highlightWord(wordIndex);
          wordIndex = (wordIndex + 1) % words.length;
        }, 320);
      }

      function stopSpeech() {
        if (fallbackStartTimer) {
          clearTimeout(fallbackStartTimer);
          fallbackStartTimer = null;
        }
        stopFallback();
        if (supportsSpeech) window.speechSynthesis.cancel();
        clearHighlight();
      }

      function playDemo() {
        clearHighlight();
        if (words.length === 0) return;

        if (!supportsSpeech) {
          startFallback();
          return;
        }

        const text = words.map((w) => w.textContent?.trim() ?? '').join(' ');
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.rate = 0.95;

        // Map each word span to its character offset in `text`, so a
        // boundary event's charIndex can be matched back to a span.
        let cursor = 0;
        const starts = words.map((w) => {
          const word = w.textContent?.trim() ?? '';
          const idx = text.indexOf(word, cursor);
          cursor = idx + word.length;
          return idx;
        });

        let boundaryFired = false;
        fallbackStartTimer = setTimeout(() => {
          if (!boundaryFired) startFallback();
        }, 600);

        utterance.onboundary = (e) => {
          if (e.name && e.name !== 'word') return;
          boundaryFired = true;
          stopFallback();
          let idx = 0;
          for (let i = 0; i < starts.length; i++) {
            if (starts[i] <= e.charIndex) idx = i;
            else break;
          }
          highlightWord(idx);
        };

        utterance.onend = () => {
          stopFallback();
          clearHighlight();
        };
        utterance.onerror = () => {
          if (!boundaryFired) startFallback();
        };

        window.speechSynthesis.cancel();
        window.speechSynthesis.speak(utterance);
      }

      // Active tab: brand-gradient pill; inactive: plain text
      const ACTIVE = 'bg-brand-gradient text-navy-900 font-semibold shadow-[0_4px_16px_-4px_rgba(91,155,248,0.6)]'.split(' ');
      function setActive(on: HTMLElement | null, off: HTMLElement | null) {
        on?.classList.add(...ACTIVE);
        on?.classList.remove('text-white/75', 'hover:text-white');
        off?.classList.remove(...ACTIVE);
        off?.classList.add('text-white/75', 'hover:text-white');
      }

      function showAfter() {
        beforePanel?.setAttribute('hidden', '');
        afterPanel?.removeAttribute('hidden');
        beforeBtn?.setAttribute('aria-pressed', 'false');
        afterBtn?.setAttribute('aria-pressed', 'true');
        setActive(afterBtn, beforeBtn);
        playDemo();
      }

      function showBefore() {
        afterPanel?.setAttribute('hidden', '');
        beforePanel?.removeAttribute('hidden');
        afterBtn?.setAttribute('aria-pressed', 'false');
        beforeBtn?.setAttribute('aria-pressed', 'true');
        setActive(beforeBtn, afterBtn);
        stopSpeech();
      }

      document.getElementById('demo-replay-btn')?.addEventListener('click', () => {
        stopSpeech();
        playDemo();
      });

      beforeBtn?.addEventListener('click', showBefore);
      afterBtn?.addEventListener('click', showAfter);

      // Stop mid-playback if the tab is hidden/navigated away from
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) stopSpeech();
      });
    </script>


    <!-- ===================== FEATURES ===================== -->
    <section id="features" class="max-w-6xl mx-auto px-6 py-16 scroll-mt-24" aria-labelledby="features-heading">
      <div class="text-center mb-16">
        <h2 id="features-heading" class="font-display text-4xl md:text-5xl text-white mb-4 animate-fade-up">
          Everything you need.<br /><span class="gradient-text">Nothing you don't.</span>
        </h2>
        <p class="text-white/75 max-w-xl mx-auto animate-fade-up delay-100">
          Seven focused tools that work on any website, with no account or setup required.
        </p>
      </div>

      <!-- Centered wrap so a short last row sits in the middle -->
      <div class="flex flex-wrap justify-center gap-5">

        {[
          {
            icon: 'read-aloud',
            title: 'Read Aloud',
            desc: 'Text-to-speech with word-by-word highlighting, built into every page. Configure voice, speed, and pitch. Works offline with your computer\'s built-in voices.',
            color: 'from-blue-500/10',
          },
          {
            icon: 'simplify',
            title: 'Simplify',
            desc: 'Right-click any text and rewrite it in plain English at Grade 3, 5, or 8 level. Powered by your choice of LLM — OpenAI, Anthropic, or a fully local Ollama model. Requires your own API key.',
            color: 'from-green-500/10',
          },
          {
            icon: 'reading-mode',
            title: 'Reading Mode',
            desc: 'Strip pages down to their content. Apply OpenDyslexic font, adjust spacing and column width, choose from four colour themes.',
            color: 'from-purple-500/10',
          },
          {
            icon: 'symbols',
            title: 'Symbol Overlay',
            desc: 'Display AAC pictogram symbols above words using the open ARASAAC library. Built for AAC users and the people who support them.',
            color: 'from-amber-500/10',
          },
          {
            icon: 'focus',
            title: 'Focus Tools',
            desc: 'Reading ruler that follows your cursor. Paragraph focus mode. Word complexity highlighting with simpler alternatives on hover.',
            color: 'from-pink-500/10',
          },
          {
            icon: 'profiles',
            title: 'Profiles',
            desc: 'Save accessibility settings as named profiles and share them as JSON. Perfect for SLPs configuring settings for a client.',
            color: 'from-cyan-500/10',
          },
          {
            icon: 'vocabulary',
            title: 'Vocabulary',
            desc: 'Double-click any word for an instant plain-English definition. Powered by a bundled offline dictionary — no API key, no internet required.',
            color: 'from-rose-500/10',
          },
        ].map(({ icon, title, desc, color }) => (
          <div class:list={[
            'relative p-6 rounded-2xl bg-gradient-to-br to-transparent border border-white/5',
            'w-full md:w-[calc(50%-0.625rem)] lg:w-[calc((100%-2.5rem)/3)]',
            'hover:border-white/10 transition-colors group animate-fade-up',
            color,
          ]}>
            <div class="w-11 h-11 mb-4 rounded-xl bg-navy-800/80 border border-white/5 flex items-center justify-center">
              <Icon name={icon} />
            </div>
            <h3 class="font-semibold text-white text-lg mb-2">{title}</h3>
            <p class="text-white/75 text-sm leading-relaxed">{desc}</p>
          </div>
        ))}

      </div>

      <div class="text-center mt-10">
        <a href="/docs/getting-started/" class="text-brand-blue hover:text-brand-green transition-colors text-sm font-medium">
          Read the docs →
        </a>
      </div>
    </section>


    <!-- ===================== SCREENSHOTS ===================== -->
    <section class="max-w-6xl mx-auto px-6 pb-24" aria-labelledby="screens-heading">
      <h2 id="screens-heading" class="font-display text-4xl text-white text-center mb-4 animate-fade-up">
        See the real thing.
      </h2>
      <p class="text-white/75 text-center max-w-xl mx-auto mb-12 animate-fade-up delay-100">
        Screenshots from the extension on an ordinary news page.
      </p>

      <figure class="animate-fade-up">
        <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl shadow-black/40">
          <img src="/screenshots/reading-mode.webp" width="1600" height="938" loading="lazy" decoding="async"
            alt="Reading Mode: a cluttered news article shown as clean, large text on a sepia background, with font, size, column width and theme controls along the top." class="w-full h-auto block" />
        </div>
        <figcaption class="text-white/75 text-sm mt-3 text-center">
          <strong class="text-white font-medium">Reading Mode</strong> strips the page down to the article, in the font, size and colours you choose.
        </figcaption>
      </figure>

      <div class="mt-10 flex flex-col md:flex-row gap-8 items-start">
        <figure class="md:flex-1 animate-fade-up">
          <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl shadow-black/40">
            <img src="/screenshots/symbol-overlay.webp" width="1600" height="963" loading="lazy" decoding="async"
              alt="Symbol Overlay: ARASAAC pictograms for words like play, want, come, school, mom and dad shown above those words in the article." class="w-full h-auto block" />
          </div>
          <figcaption class="text-white/75 text-sm mt-3 text-center">
            <strong class="text-white font-medium">Symbol Overlay</strong> puts AAC pictograms above key words, on the page you're already reading.
          </figcaption>
        </figure>
        <figure class="w-full md:w-60 shrink-0 animate-fade-up delay-100">
          <div class="rounded-2xl overflow-hidden border border-white/10 shadow-2xl shadow-black/40 max-w-60 mx-auto">
            <img src="/screenshots/popup.webp" width="480" height="900" loading="lazy" decoding="async"
              alt="The ClearPath popup: a Read Page button, Reading Mode, and sections for Focus Tools, Symbol Overlay, Vocabulary, Profiles and settings." class="w-full h-auto block" />
          </div>
          <figcaption class="text-white/75 text-sm mt-3 text-center">
            <strong class="text-white font-medium">The popup</strong> holds every tool and setting.
          </figcaption>
        </figure>
      </div>
    </section>


    <!-- ===================== WHO IT'S FOR ===================== -->
    <section class="py-24 border-y border-white/5" aria-labelledby="who-heading">
      <div class="max-w-6xl mx-auto px-6">
        <h2 id="who-heading" class="font-display text-4xl text-white text-center mb-12 animate-fade-up">
          Built for real people.
        </h2>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          {[
            { group: 'AAC users', detail: 'Symbols + simplification on any website' },
            { group: 'Dyslexia', detail: 'OpenDyslexic font, reading ruler, TTS' },
            { group: 'Cognitive disabilities', detail: 'Plain language, reduced complexity' },
            { group: 'SLPs & caregivers', detail: 'Shareable profiles for clients' },
          ].map(({ group, detail }) => (
            <div class="relative overflow-hidden p-5 pt-6 rounded-xl bg-navy-800/90 border border-white/10 shadow-lg shadow-black/30 hover:border-brand-blue/40 transition-colors animate-fade-up">
              <span class="absolute left-0 right-0 top-0 h-1 bg-brand-gradient" aria-hidden="true"></span>
              <p class="font-semibold text-white text-sm mb-1">{group}</p>
              <p class="text-white/75 text-xs leading-relaxed">{detail}</p>
            </div>
          ))}
        </div>
      </div>
    </section>


    <!-- ===================== PRIVACY CALLOUT ===================== -->
    <section class="max-w-3xl mx-auto px-6 py-24 text-center">
      <div class="p-8 rounded-2xl bg-navy-800/30 border border-white/5 gradient-border animate-fade-up">
        <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-navy-800/80 border border-white/5 flex items-center justify-center">
          <Icon name="privacy" size={30} />
        </div>
        <h2 class="font-display text-3xl text-white mb-4">Your data goes nowhere.</h2>
        <p class="text-white/75 leading-relaxed">
          No analytics. No telemetry. No servers. Settings stay in your browser, and your API key never leaves your device.
          If you use LLM features, text goes directly from your browser to your API provider — never through us.
          Everything is open source and auditable.
        </p>
        <a href="/privacy/" class="inline-block mt-6 text-sm text-brand-blue hover:text-brand-green transition-colors">
          Read the privacy policy →
        </a>
      </div>
    </section>


    <!-- ===================== FAQ ===================== -->
    <section class="max-w-3xl mx-auto px-6 py-16" aria-labelledby="faq-heading">
      <h2 id="faq-heading" class="font-display text-4xl text-white text-center mb-12 animate-fade-up">
        Questions, answered.
      </h2>

      <div class="space-y-4">
        {[
          {
            q: 'Does ClearPath cost anything?',
            a: "No. ClearPath is completely free and open source — no subscription, no ads, no account, no trial that expires.",
          },
          {
            q: 'Will it slow down my browsing?',
            a: "No. ClearPath's features only activate when you use them — reading a page aloud, opening Reading Mode, and so on. There's no background analysis or network activity until you ask for it.",
          },
          {
            q: 'What data does ClearPath collect?',
            a: 'None. No analytics, no telemetry, no tracking of any kind. Settings sync only through your own browser account, and your API key stays on the device where you entered it.',
          },
          {
            q: 'Do I need an account to use it?',
            a: 'No account, ever — for ClearPath itself. Install it and everything except Simplify works immediately.',
          },
          {
            q: 'Do I need an API key?',
            a: "Only for Simplify, which rewrites text using an LLM you bring your own API key for (OpenAI, Anthropic, or a local Ollama model). Read Aloud, Reading Mode, Focus Tools, Symbol Overlay, and Vocabulary all work without one.",
          },
          {
            q: 'Which browsers does it support?',
            a: 'Chrome, plus Edge, Brave, Arc, and Opera. Until the Chrome Web Store listing is live it installs from source, which takes a couple of minutes. Firefox support is planned after Chrome.',
          },
        ].map(({ q, a }) => (
          <div class="relative overflow-hidden p-6 pl-7 rounded-xl bg-navy-800/90 border border-white/10 shadow-lg shadow-black/30 hover:border-brand-blue/40 transition-colors animate-fade-up">
            <span class="absolute left-0 top-0 bottom-0 w-1 bg-brand-gradient" aria-hidden="true"></span>
            <h3 class="font-semibold text-white text-base mb-2">{q}</h3>
            <p class="text-white/75 text-sm leading-relaxed">{a}</p>
          </div>
        ))}
      </div>
    </section>


    <!-- ===================== OPEN SOURCE CTA ===================== -->
    <section class="max-w-6xl mx-auto px-6 py-16 text-center">
      <h2 class="font-display text-4xl text-white mb-4 animate-fade-up">
        Community built.<br /><span class="gradient-text">Everyone welcome.</span>
      </h2>
      <p class="text-white/75 max-w-xl mx-auto mb-8 animate-fade-up delay-100">
        ClearPath is open source and welcomes contributors: developers, designers, SLPs, and
        accessibility advocates.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 animate-fade-up delay-200">
        <a
          href="https://github.com/clearpath-ext/clearpath-extension/blob/main/CONTRIBUTING.md"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 rounded-xl font-medium text-white border border-white/10 hover:border-white/20 transition-all"
        >
          Contributing guide
        </a>
        <a
          href="https://github.com/clearpath-ext/clearpath-extension/issues?q=is%3Aissue+is%3Aopen+label%3A%22good+first+issue%22"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 rounded-xl font-medium text-brand-blue hover:text-brand-green transition-colors"
        >
          Browse good first issues →
        </a>
      </div>
    </section>

  </main>

  <Footer />
</Base>
