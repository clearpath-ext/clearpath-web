---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---

<Base
  title="Vocabulary"
  description="Instant plain-English word definitions on any webpage — fully offline, no API key required."
>
  <Nav />

  <main id="main-content" class="pt-32 pb-24">
    <div class="max-w-3xl mx-auto px-6">

      <div class="mb-12">
        <a href="/docs/getting-started" class="text-sm text-white/40 hover:text-white transition-colors">← Getting Started</a>
      </div>

      <h1 class="font-display text-5xl text-white mb-4">Vocabulary</h1>
      <p class="text-white/50 text-lg mb-12">Instant plain-English definitions — on any website, fully offline.</p>

      <div class="space-y-10">

        <section>
          <h2 class="font-display text-2xl text-white mb-4">What is Vocabulary?</h2>
          <p class="text-white/60 leading-relaxed">
            Double-click any word on a page and ClearPath shows a plain-English definition in a small tooltip — no lookup, no new tab, no API key. It works completely offline, powered by a dictionary bundled with the extension itself.
          </p>
          <p class="text-white/60 leading-relaxed mt-3">
            The definitions come from{' '}
            <a href="https://simple.wiktionary.org" target="_blank" rel="noopener noreferrer" class="text-brand-blue hover:text-brand-green transition-colors">Simple English Wiktionary</a>
            {' '}— written in plain English by design, which makes it a good match for anyone who wants a quick, clear definition instead of a dictionary-style one.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-white mb-4">Using Vocabulary</h2>
          <ol class="space-y-4">
            {[
              'Click the ClearPath icon in your toolbar to open the popup.',
              'Toggle Vocabulary on.',
              'Double-click any word on the page to see its definition.',
              'Dismiss the definition by pressing Escape or clicking anywhere else on the page.',
            ].map((step, i) => (
              <li class="flex gap-4">
                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-brand-gradient flex items-center justify-center text-navy-900 font-bold text-xs">
                  {i + 1}
                </span>
                <p class="text-white/60 text-sm pt-0.5">{step}</p>
              </li>
            ))}
          </ol>
        </section>

        <section>
          <h2 class="font-display text-2xl text-white mb-4">Why offline?</h2>
          <p class="text-white/60 leading-relaxed">
            Vocabulary doesn't call any API or server — the dictionary (over 21,000 entries) ships inside the extension itself. That means it works without an internet connection, without an API key, and without sending anything about what you're reading anywhere. It's available to everyone immediately after installing, with nothing to configure.
          </p>
        </section>

        <section>
          <h2 class="font-display text-2xl text-white mb-4">License</h2>
          <p class="text-white/60 text-sm leading-relaxed">
            Definitions are derived from{' '}
            <a href="https://simple.wiktionary.org" target="_blank" rel="noopener noreferrer" class="text-brand-blue hover:text-brand-green transition-colors">Simple English Wiktionary</a>
            {' '}and used under{' '}
            <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener noreferrer" class="text-brand-blue hover:text-brand-green transition-colors">
              CC BY-SA 4.0
            </a>.
          </p>
        </section>

      </div>

    </div>
  </main>

  <Footer />
</Base>
